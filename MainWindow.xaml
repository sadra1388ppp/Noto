                <!-- Bat stays in the same safe area and is fully visible -->
                <Canvas Width="94"
                        Height="38"
                        Canvas.Right="302"
                        Canvas.Top="76">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="HalloweenBatTranslate" X="0"/>
                    </Canvas.RenderTransform>

                    <Path Data="M 47,19
