<Window x:Class="SimpleReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Reminders"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2865DB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F1F3F6"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#70757D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="Foreground" Value="#202329"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReminderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#24272C"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E6E8EB"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reminders"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#15171A"
                           Margin="6,6,0,24"/>

                <ListBox Grid.Row="1"
                         x:Name="ListsList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ListsList_SelectionChanged">

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="All Reminders"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SidebarAllCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       FontSize="12"
                                       Foreground="#9297A0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Rewards"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Store"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Achievements"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">

                    <TextBlock Text="MY LISTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#9499A1"
                               Margin="7,0,0,10"/>

                    <ListBox x:Name="CustomListsList"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="CustomListsList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="0"
                                        CornerRadius="8">

                                    <Border.ContextMenu>

                                        <ContextMenu
                                            Style="{StaticResource ListContextMenuStyle}"
                                            DataContext="{Binding PlacementTarget.DataContext,
                                                RelativeSource={RelativeSource Self}}">

                                            <MenuItem Header="Delete List"
                                                      Style="{StaticResource DeleteMenuItemStyle}"
                                                      Click="DeleteList_Click"/>

                                        </ContextMenu>

                                    </Border.ContextMenu>

                                    <Grid Margin="2,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#3478F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   Foreground="#555B66"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock x:Name="NoListsText"
                               Text="No custom lists"
                               FontSize="13"
                               Foreground="#9A9FA7"
                               Margin="12,6,0,0"/>

                </StackPanel>

                <Border Grid.Row="3"
                        x:Name="NewListPanel"
                        Visibility="Collapsed"
                        Background="#F6F7F9"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="9"
                        Margin="0,10,0,8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewListInput"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CreateList_Click"/>

                        <Button Grid.Column="2"
                                Content="×"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CancelNewList_Click"/>

                    </Grid>

                </Border>

                <Button Grid.Row="4"
                        Content="+  New List"
                        Style="{StaticResource ActionButtonStyle}"
                        HorizontalContentAlignment="Left"
                        FontWeight="SemiBold"
                        Click="NewListButton_Click"/>

            </Grid>

        </Border>

        <!-- Main -->
        <Grid x:Name="ReminderContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,26">

                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="All Reminders"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Everything you want to remember, in one place."
                               FontSize="14"
                               Foreground="#7D828A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="255"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9">

                    <TextBox x:Name="SearchInput"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Search reminders"
                             TextChanged="SearchInput_TextChanged"/>
                </Border>

            </Grid>

            <!-- Add Reminder -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,24">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReminderInput"
                             Grid.Column="0"
                             Height="42"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Reminder title"/>

                    <DatePicker x:Name="DueDatePicker"
                                Grid.Column="1"
                                Height="42"
                                Margin="10,0,10,0"
                                VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Add Reminder"
                            Width="125"
                            Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddReminder_Click"/>

                </Grid>

            </Border>

            <!-- Reminder list -->
            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="2,0,2,10">

                    <TextBlock Text="Reminders"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#25282D"/>

                    <TextBlock x:Name="ReminderCountText"
                               HorizontalAlignment="Right"
                               Text="0"
                               FontSize="13"
                               Foreground="#858A92"/>

                </Grid>

                <Grid Grid.Row="1">

                    <ListBox x:Name="ReminderList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ReminderItemStyle}">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White"
                                        BorderBrush="#E5E7EA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ReminderCheckBoxStyle}"
                                                      PreviewMouseLeftButtonDown="ReminderCheckBox_PreviewMouseLeftButtonDown"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:d}'}"
                                                       FontSize="12"
                                                       Foreground="#898F98"
                                                       Margin="26,5,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="×"
                                                Width="32"
                                                Height="32"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Tag="{Binding}"
                                                Click="DeleteReminder_Click"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="No reminders"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#34373C"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Add your first reminder above."
                                   FontSize="14"
                                   Foreground="#8A8F97"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <!-- Rewards -->
        <Grid x:Name="RewardsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Rewards"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Complete your reminders and build your coin balance."
                               FontSize="14"
                               Foreground="#7B818A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16"
                                VerticalAlignment="Center">

                            <Grid>
                                <Ellipse Width="22"
                                         Height="22"
                                         Stroke="#C79620"
                                         StrokeThickness="2"
                                         Fill="#FFD966"/>

                                <TextBlock Text="C"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#8A6815"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                            <TextBlock Text="COIN BALANCE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>

                            <TextBlock x:Name="RewardsCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#17191C"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="64"
                            Height="64"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="14"
                            VerticalAlignment="Center">

                        <Grid>
                            <Ellipse Width="38"
                                     Height="38"
                                     Fill="#FFD966"
                                     Stroke="#C79620"
                                     StrokeThickness="2"/>

                            <TextBlock Text="C"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#8A6815"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="18,0,30,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Complete a reminder"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#202329"/>

                        <TextBlock Text="Every reminder you genuinely finish earns 10 coins."
                                   FontSize="13"
                                   Foreground="#737A84"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#FFF8E5"
                            BorderBrush="#F0D889"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,12"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+10"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#9A731A"/>

                            <TextBlock Text=" Coins"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#9A731A"
                                       VerticalAlignment="Center"
                                       Margin="4,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#F8F9FA"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    VerticalAlignment="Top">

                <StackPanel>
                    <TextBlock Text="Reward status"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#202329"/>

                    <TextBlock x:Name="RewardsStatusText"
                               Text="Finish a reminder to earn 10 coins."
                               FontSize="13"
                               Foreground="#737A84"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Store -->
        <Grid x:Name="StoreContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Store"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Spend your coins on themes and personalize the app."
                               FontSize="14"
                               Foreground="#7B818A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16"
                                VerticalAlignment="Center">

                            <Grid>
                                <Ellipse Width="22"
                                         Height="22"
                                         Stroke="#C79620"
                                         StrokeThickness="2"
                                         Fill="#FFD966"/>

                                <TextBlock Text="C"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#8A6815"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                            <TextBlock Text="YOUR COINS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>

                            <TextBlock x:Name="StoreCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#17191C"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="StoreItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Width="220"
                                        Background="#FAFBFC"
                                        BorderBrush="#E4E7EA"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="15"
                                        Margin="0,0,12,12">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="82"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                Margin="0,0,0,13">

                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="42"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>

                                                <TextBlock Text="T"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202329"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#7B818A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,13"/>

                                        <Button Grid.Row="3"
                                                Content="{Binding ActionText}"
                                                Tag="{Binding}"
                                                Height="36"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="StoreItemButton_Click"/>
                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Border>

        </Grid>

        <!-- Achievements -->
        <Grid x:Name="AchievementsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">

                <TextBlock Text="Achievements"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#17191C"/>

                <TextBlock Text="Milestones will appear here in a future update."
                           FontSize="14"
                           Foreground="#7B818A"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="30">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500">

                    <Border Width="72"
                            Height="72"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="18"
                            HorizontalAlignment="Center">

                        <TextBlock Text="A"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="No achievements yet"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#202329"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>

                    <TextBlock Text="The achievement system is currently empty. We will add real milestones later."
                               FontSize="13"
                               Foreground="#7B818A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Completion Confirmation -->
        <Grid x:Name="CompletionConfirmationOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="#66000000">

            <Border Width="470"
                    Background="White"
                    CornerRadius="20"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="8"
                                      Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>

                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="16"
                            HorizontalAlignment="Left">

                        <TextBlock Text="?"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="One quick question"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#17191C"
                               Margin="0,20,0,0"/>

                    <TextBlock Text="Did you actually finish this, or are you trying to fool me?"
                               FontSize="15"
                               Foreground="#666D76"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Border Background="#F7F8FA"
                            BorderBrush="#E5E7EA"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,18,0,0">

                        <TextBlock x:Name="ConfirmationReminderText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#353A41"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Confirming this reminder will add 10 coins."
                               FontSize="12"
                               Foreground="#8A9098"
                               Margin="0,10,0,0"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Not yet"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#F1F3F5"
                                Foreground="#4C535C"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="CancelCompletionConfirmation_Click"/>

                        <Button Grid.Column="1"
                                Content="Yes, I finished"
                                Height="40"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="ConfirmCompletion_Click"/>
                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>