                                                            <Ellipse Width="5" Height="5" Canvas.Left="38" Canvas.Top="34" Fill="#FFD8FF8B"/>
                                                            <Ellipse Width="4" Height="4" Canvas.Left="111" Canvas.Top="24" Fill="#FFBDF47D"/>
                                                            <Ellipse Width="5" Height="5" Canvas.Left="175" Canvas.Top="43" Fill="#FFE5FFA0"/>
                                                            <Ellipse Width="4" Height="4" Canvas.Left="247" Canvas.Top="27" Fill="#FFC9F27B"/>

                                                            <Path Data="M 16,92 C 26,79 42,80 49,91 C 42,102 27,103 16,92 Z"
                                                                  Fill="#FF4D8C4E"/>
                                                            <Path Data="M 251,99 C 263,86 278,88 286,99 C 278,111 264,111 251,99 Z"
                                                                  Fill="#FF619D58"/>

                                                            <TextBlock Text="MOONLIT FOREST"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFD5E8CB"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Top"
                                                                       Margin="16,14,0,0"
                                                                       Opacity="0.88"/>
                                                        </Grid>

                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="1"
                                                      Margin="2,12,2,0">

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>

                                                    <Border HorizontalAlignment="Right"
                                                            Background="{Binding PreviewSoft}"
                                                            CornerRadius="7"
                                                            Padding="7,4">

                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding PreviewAccent}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="2,7,2,10"
                                                           VerticalAlignment="Top"/>

                                                <Grid Grid.Row="3"
                                                      Margin="2,0,2,0">

                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">

                                                        <Border Width="25"
                                                                Height="25"
                                                                Background="#FFF3C4"
                                                                CornerRadius="12.5">

                                                            <TextBlock Text="C"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="#8A6815"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Price}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Text=" coins"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Tag="{Binding}"
                                                            Content="{Binding ActionText}"
                                                            Style="{StaticResource StorePurchaseButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            Click="StoreItemButton_Click"/>
                                                </Grid>

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border x:Name="StoreEmptyStatePanel"
                                Visibility="Collapsed"
                                Background="{DynamicResource SurfaceSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="28">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Border Width="72"
                                        Height="72"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="36"
                                        HorizontalAlignment="Center">

                                    <TextBlock x:Name="StoreCategoryIcon"
                                               Text="A"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="StoreCategoryEmptyTitle"
                                           Text="No items available yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BodyTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,4"/>

                                <TextBlock x:Name="StoreCategoryEmptyText"
                                           Text="There are no Store items available yet."
                                           FontSize="13"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- Achievements -->
        <Grid x:Name="AchievementsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">
                <TextBlock Text="Achievements"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Complete reminders, earn coins, and keep building your streak."
                           FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="180"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="88"
                            Height="88"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="24"
                            VerticalAlignment="Center">

                        <Grid>
                            <Ellipse Width="56"
                                     Height="56"
                                     Stroke="#C79620"
                                     StrokeThickness="3"
                                     Fill="#FFD966"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="C"
                                       Foreground="#8A6815"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="22,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Complete a reminder"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Finish a reminder and earn coins every time."
                                   FontSize="13"
                                   Foreground="#747A83"
                                   Margin="0,5,0,11"/>

                        <Border Width="110"
                                Height="34"
                                Background="#FFF8E5"
                                BorderBrush="#F0D889"
                                BorderThickness="1"
                                CornerRadius="9">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="+10"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#9A731A"/>

                                <TextBlock Text=" coins"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#9A731A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Completion Confirmation -->
        <Grid x:Name="CompletionConfirmationOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="#66000000">

            <Border Width="470"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="20"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="8"
                                      Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>

                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="16"
                            HorizontalAlignment="Left">

                        <TextBlock Text="?"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="One quick question"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,20,0,0"/>

                    <TextBlock Text="Did you actually finish this, or are you trying to fool me?"
                               FontSize="15"
                               Foreground="#666D76"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Border Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,18,0,0">

                        <TextBlock x:Name="ConfirmationReminderText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#353A41"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Confirming this reminder will add 10 coins."
                               FontSize="12"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="0,10,0,0"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Not yet"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#F1F3F5"
                                Foreground="#4C535C"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="CancelCompletionConfirmation_Click"/>

                        <Button Grid.Column="1"
                                Content="Yes, I finished"
                                Height="40"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="ConfirmCompletion_Click"/>
                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>