                    <Ellipse Width="19"
                             Height="11"
                             Canvas.Left="46"
                             Canvas.Top="43"
                             Fill="#FFCFC0D8"
                             Opacity="0.25"/>
                    <Ellipse Width="8"
                             Height="6"
                             Canvas.Left="24"
                             Canvas.Top="54"
                             Fill="#FFCFC0D8"
                             Opacity="0.23"/>

                    <Ellipse Width="82"
                             Height="82"
                             Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#FFE3C6FF" Offset="0.44"/>
                                <GradientStop Color="#00000000" Offset="1"/>
