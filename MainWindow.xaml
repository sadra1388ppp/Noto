<Window x:Class="SimpleReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Reminders"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2865DB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="ContentSoftBrush" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E5E9"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CDD2D8"/>
        <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#F1F3F6"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17191C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#202329"/>
        <SolidColorBrush x:Key="BodyTextBrush" Color="#30353B"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555B66"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7B818A"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A9098"/>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverSurfaceBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="Foreground" Value="#202329"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReminderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="21"
                                  Height="21"
                                  Margin="0,0,11,0"
                                  VerticalAlignment="Center">

                                <Border x:Name="CheckBoxBorder"
                                        Width="21"
                                        Height="21"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"/>

                                <Path x:Name="CheckMark"
                                      Data="M 4.5,10.5 L 8.5,14.2 L 16.5,6.5"
                                      Stroke="White"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter Property="Foreground"
                                        Value="#8E949C"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                                <Setter Property="Foreground"
                                        Value="#A0A5AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                                Width="32"
                                Height="32"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#FFF1F1"/>
                                <Setter Property="Foreground"
                                        Value="#D64545"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#FFE3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DueDateIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#737982"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="38"
                              Height="38"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale"
                                                ScaleX="1"
                                                ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Ellipse x:Name="HoverSurface"
                                     Width="34"
                                     Height="34"
                                     Fill="{DynamicResource AccentSoftBrush}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <Grid Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <Path x:Name="CalendarIcon"
                                      Data="M 5,3.5 L 5,6.5 M 15,3.5 L 15,6.5 M 4.5,5.5 H 15.5 Q 18,5.5 18,8 V 15.5 Q 18,18 15.5,18 H 4.5 Q 2,18 2,15.5 V 8 Q 2,5.5 4.5,5.5 Z M 2.8,9 H 17.2"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <Path x:Name="CalendarIconAccent"
                                      Data="M 5,3.5 L 5,6.5 M 15,3.5 L 15,6.5 M 4.5,5.5 H 15.5 Q 18,5.5 18,8 V 15.5 Q 18,18 15.5,18 H 4.5 Q 2,18 2,15.5 V 8 Q 2,5.5 4.5,5.5 Z M 2.8,9 H 17.2"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Opacity="0"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0">

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0"
                                            Opacity="0">

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97"
                                                             Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorePurchaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StoreButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Background"
                                        Value="#E7E9ED"/>
                                <Setter Property="Foreground"
                                        Value="#8A9098"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEquipped}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
</Style.Triggers>
        </Style>

        <Style x:Key="StoreCategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid x:Name="RootLayout">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Moonlit Forest decorative layer -->
        <Grid x:Name="ForestEffectsOverlay"
              Grid.ColumnSpan="2"
              Height="118"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Panel.ZIndex="1"
              Visibility="Collapsed"
              ClipToBounds="True">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Canopy on the sidebar -->
            <Canvas Grid.Column="0" ClipToBounds="True">
                <Path Data="M -5,18 C 38,4 84,10 126,28 C 157,40 184,38 220,26"
                      Stroke="#FF163B25"
                      StrokeThickness="12"
                      StrokeStartLineCap="Round"
                      Fill="Transparent"
                      Opacity="0.92"/>
                <Ellipse Width="34" Height="17" Canvas.Left="28" Canvas.Top="12" Fill="#FF4D8B51">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="18"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="29" Height="16" Canvas.Left="76" Canvas.Top="20" Fill="#FF3D7645">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="28"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="28" Height="16" Canvas.Left="119" Canvas.Top="27" Fill="#FF5C9A5A">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="26"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="24" Height="14" Canvas.Left="159" Canvas.Top="22" Fill="#FF315F39">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="12"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Main header: only in the empty center band, never over search/coin controls -->
            <Canvas Grid.Column="1"
                    Margin="310,0,310,0"
                    ClipToBounds="True">

                <Path Data="M 12,-12 C 28,17 29,41 44,61 C 57,78 79,86 91,106"
                      Stroke="#FF356E42"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      Fill="Transparent"
                      Opacity="0.74"/>

                <Ellipse Width="18" Height="10" Canvas.Left="8" Canvas.Top="27" Fill="#FF5C9B60"/>
                <Ellipse Width="16" Height="9" Canvas.Left="35" Canvas.Top="49" Fill="#FF467E50">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="24"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="14" Height="8" Canvas.Left="60" Canvas.Top="75" Fill="#FF71AC6C">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-18"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas Width="16" Height="16" Canvas.Left="102" Canvas.Top="18">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="ForestFireflyTranslateA"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="6" Height="6"
                             Canvas.Left="5" Canvas.Top="5"
                             Fill="#FFD2FF82"
                             Opacity="0.86"/>
                </Canvas>

                <Canvas Width="16" Height="16" Canvas.Left="155" Canvas.Top="55">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="ForestFireflyTranslateB"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="5" Height="5"
                             Canvas.Left="5" Canvas.Top="5"
                             Fill="#FFE2FF9B"
                             Opacity="0.78"/>
                </Canvas>

                <Ellipse x:Name="ForestFireflyOpacityA"
                         Width="5" Height="5"
                         Canvas.Left="132" Canvas.Top="36"
                         Fill="#FFC4F27C"/>

                <Ellipse Width="4" Height="4" Canvas.Left="190" Canvas.Top="26"
                         Fill="#FFB7EC78" Opacity="0.70"/>
                <Ellipse Width="3" Height="3" Canvas.Left="202" Canvas.Top="75"
                         Fill="#FFE0FF9D" Opacity="0.65"/>

                <Canvas Width="22" Height="22"
                        Canvas.Left="220" Canvas.Top="79">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="ForestLeafTranslate"/>
                            <RotateTransform x:Name="ForestLeafRotate" Angle="-18"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Path Data="M 2,10 C 8,2 17,2 20,10 C 15,18 7,19 2,10 Z"
                          Fill="#FF6FA85B"
                          Opacity="0.78"/>
                    <Path Data="M 4,10 L 18,10"
                          Stroke="#FFB2D98A"
                          StrokeThickness="1"
                          Opacity="0.55"/>
                </Canvas>
            </Canvas>
        </Grid>

        <!-- Halloween decorative layer: clipped to a safe header band so it never hides app controls -->
        <Grid x:Name="HalloweenEffectsOverlay"
              Grid.ColumnSpan="2"
              Height="118"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              ClipToBounds="True">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
