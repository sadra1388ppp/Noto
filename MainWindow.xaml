                <!-- Content pumpkin -->
                <Canvas Width="54"
                        Height="88"
                        Canvas.Left="250"
                        Canvas.Top="-22"
                        RenderTransformOrigin="0.5,0"
                        IsHitTestVisible="False">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HalloweenPumpkinRightRotate" Angle="3"/>
                    </Canvas.RenderTransform>

                    <Line X1="27" Y1="0" X2="27" Y2="27"
                          Stroke="#FF58485F" StrokeThickness="1.5"/>
                    <Line X1="27" Y1="1" X2="27" Y2="27"
                          Stroke="#FFC7B5CC" StrokeThickness="0.7"/>

                    <Path Data="M 27,25
