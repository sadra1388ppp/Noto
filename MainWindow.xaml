<Window x:Class="SimpleReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Reminders"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2865DB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F1F3F6"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#70757D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="Foreground" Value="#202329"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReminderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#24272C"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="22"
                                  Height="22"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">

                                <Border x:Name="CheckBoxBorder"
                                        Width="22"
                                        Height="22"
                                        Background="White"
                                        BorderBrush="#C9CDD3"
                                        BorderThickness="1.8"
                                        CornerRadius="7"/>

                                <Path x:Name="CheckMark"
                                      Data="M 5,11 L 9,15 L 17,7"
                                      Stroke="White"
                                      StrokeThickness="2.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter Property="Foreground"
                                        Value="#9297A0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                                <Setter Property="Foreground"
                                        Value="#A0A5AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DueDateIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#737982"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E6E8EB"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reminders"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#15171A"
                           Margin="6,6,0,24"/>

                <ListBox Grid.Row="1"
                         x:Name="ListsList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ListsList_SelectionChanged">

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="All Reminders"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SidebarAllCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       FontSize="12"
                                       Foreground="#9297A0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Calendar"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Rewards"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Achievements"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Store"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">

                    <TextBlock Text="MY LISTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#9499A1"
                               Margin="7,0,0,10"/>

                    <ListBox x:Name="CustomListsList"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="CustomListsList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="0"
                                        CornerRadius="8">

                                    <Border.ContextMenu>

                                        <ContextMenu
                                            Style="{StaticResource ListContextMenuStyle}"
                                            DataContext="{Binding PlacementTarget.DataContext,
                                                RelativeSource={RelativeSource Self}}">

                                            <MenuItem Header="Delete List"
                                                      Style="{StaticResource DeleteMenuItemStyle}"
                                                      Click="DeleteList_Click"/>

                                        </ContextMenu>

                                    </Border.ContextMenu>

                                    <Grid Margin="2,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#3478F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   Foreground="#555B66"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock x:Name="NoListsText"
                               Text="No custom lists"
                               FontSize="13"
                               Foreground="#9A9FA7"
                               Margin="12,6,0,0"/>

                </StackPanel>

                <Border Grid.Row="3"
                        x:Name="NewListPanel"
                        Visibility="Collapsed"
                        Background="#F6F7F9"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="9"
                        Margin="0,10,0,8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewListInput"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CreateList_Click"/>

                        <Button Grid.Column="2"
                                Content="×"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CancelNewList_Click"/>

                    </Grid>

                </Border>

                <Button Grid.Row="4"
                        Content="+  New List"
                        Style="{StaticResource ActionButtonStyle}"
                        HorizontalContentAlignment="Left"
                        FontWeight="SemiBold"
                        Click="NewListButton_Click"/>

            </Grid>

        </Border>

        <!-- Main -->
        <Grid x:Name="ReminderContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,26">

                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="All Reminders"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Everything you want to remember, in one place."
                               FontSize="14"
                               Foreground="#7D828A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="255"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9">

                    <TextBox x:Name="SearchInput"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Search reminders"
                             TextChanged="SearchInput_TextChanged"/>
                </Border>

            </Grid>

            <!-- Add Reminder -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReminderInput"
                             Grid.Column="0"
                             Height="46"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Reminder title"/>

                    <Grid Grid.Column="1"
                          Margin="10,0,10,0">

                        <Border Height="46"
                                Background="#F8F9FB"
                                BorderBrush="#E2E5E9"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="DueDatePlaceholderText"
                                               Text="Choose date"
                                               FontSize="12"
                                               Foreground="#9A9FA7"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <TextBox x:Name="DueDateInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             Foreground="#30353B"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Type a date, for example: tomorrow, Oct 12, or 12/10/2026"
                                             TextChanged="DueDateInput_TextChanged"
                                             LostFocus="DueDateInput_LostFocus"
                                             KeyDown="DueDateInput_KeyDown"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DueDateIconButtonStyle}"
                                        Click="DueDateButton_Click"
                                        ToolTip="Choose a date from the calendar">

                                    <Viewbox Width="18" Height="18">
                                        <Grid Width="24" Height="24">
                                            <Border Width="16"
                                                    Height="15"
                                                    Margin="0,5,0,0"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1.8"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            <Border Width="12"
                                                    Height="3"
                                                    Margin="0,3,0,0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="1.5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"/>

                                            <Rectangle Width="2"
                                                       Height="4"
                                                       Fill="{DynamicResource AccentBrush}"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Margin="4,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>

                                            <Rectangle Width="2"
                                                       Height="4"
                                                       Fill="{DynamicResource AccentBrush}"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Margin="0,0,4,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"/>

                                            <Grid Margin="0,10,0,0"
                                                  Width="7"
                                                  Height="5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top">
                                                <Ellipse Width="2"
                                                         Height="2"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="2"
                                                         Height="2"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"/>
                                                <Ellipse Width="2"
                                                         Height="2"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="DueDatePopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DueDateInput}"
                               HorizontalOffset="-12"
                               VerticalOffset="10"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">

                            <Border Width="320"
                                    Background="White"
                                    BorderBrush="#E0E4E8"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      ShadowDepth="5"
                                                      Opacity="0.18"/>
                                </Border.Effect>

                                <StackPanel>
                                    <Grid Margin="2,0,2,12">
                                        <StackPanel>
                                            <TextBlock Text="Choose a due date"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17191C"/>

                                            <TextBlock Text="Pick a date or type one directly above."
                                                       FontSize="11"
                                                       Foreground="#8A9098"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Content="Today"
                                                Width="58"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateToday_Click"/>
                                    </Grid>

                                    <Calendar x:Name="DueDateCalendar"
                                              BorderThickness="0"
                                              Background="White"
                                              Foreground="#30353B"
                                              SelectedDatesChanged="DueDateCalendar_SelectedDatesChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Button Content="Tomorrow"
                                                Width="78"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Foreground="#6E747C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateTomorrow_Click"/>

                                        <Button Content="Clear"
                                                Width="52"
                                                Height="32"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                Foreground="#6E747C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="ClearDueDate_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="2"
                            Content="Add Reminder"
                            Width="125"
                            Height="46"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddReminder_Click"/>

                </Grid>

            </Border>

            <!-- Reminder list -->
            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="2,0,2,10">

                    <TextBlock Text="Reminders"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#25282D"/>

                    <TextBlock x:Name="ReminderCountText"
                               HorizontalAlignment="Right"
                               Text="0"
                               FontSize="13"
                               Foreground="#858A92"/>

                </Grid>

                <Grid Grid.Row="1">

                    <ListBox x:Name="ReminderList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ReminderItemStyle}">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="White"
                                        BorderBrush="#E5E7EA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ReminderCheckBoxStyle}"
                                                      PreviewMouseLeftButtonDown="ReminderCheckBox_PreviewMouseLeftButtonDown"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:d}'}"
                                                       FontSize="12"
                                                       Foreground="#8C929A"
                                                       Margin="32,5,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="×"
                                                Width="32"
                                                Height="32"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Tag="{Binding}"
                                                Click="DeleteReminder_Click"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="No reminders"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#34373C"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Add your first reminder above."
                                   FontSize="14"
                                   Foreground="#8A8F97"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <!-- History -->
        <Grid x:Name="HistoryContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">
                <TextBlock Text="History"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#17191C"/>
                <TextBlock Text="A clean record of the reminders you've completed."
                           FontSize="14"
                           Foreground="#7B818A"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <UniformGrid Columns="3">
                    <Border Background="White"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="16"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="COMPLETED"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>
                            <TextBlock x:Name="HistoryCompletedCountText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#202329"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="16"
                            Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="COINS EARNED"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>
                            <TextBlock x:Name="HistoryCoinsText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#202329"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="16"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="LATEST"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="HistoryLatestText"
                                       Text="Nothing yet"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#202329"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFBFC"
                                        BorderBrush="#E4E7EA"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,0,0,9">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36"
                                                Height="36"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✓"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#30353B"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat={}{0:dddd, MMM d, yyyy}}"
                                                       FontSize="11"
                                                       Foreground="#7B818A"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#FFF8E5"
                                                BorderBrush="#F0D889"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="+10 coins"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9A731A"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Border>
        </Grid>

        <!-- Calendar -->
        <Grid x:Name="CalendarContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Calendar"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="See your reminders by date and keep the month in view."
                               FontSize="14"
                               Foreground="#7B818A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Today"
                            Width="72"
                            Height="38"
                            Margin="0,0,8,0"
                            Background="White"
                            Foreground="#4E555E"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="CalendarToday_Click"/>

                    <Button Content="‹"
                            Width="38"
                            Height="38"
                            Margin="0,0,5,0"
                            Background="White"
                            Foreground="#4E555E"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            FontSize="22"
                            Click="PreviousMonth_Click"/>

                    <Button Content="›"
                            Width="38"
                            Height="38"
                            Background="White"
                            Foreground="#4E555E"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            FontSize="22"
                            Click="NextMonth_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,18,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CalendarMonthText"
                                   Text="October 2026"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#202329"
                                   Margin="2,0,0,16"/>

                        <UniformGrid Grid.Row="1"
                                     Columns="7"
                                     Margin="0,0,0,7">

                            <TextBlock Text="SUN" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="MON" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="TUE" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="WED" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="THU" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="FRI" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="SAT" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>

                        </UniformGrid>

                        <UniformGrid x:Name="CalendarDaysGrid"
                                     Grid.Row="2"
                                     Rows="6"
                                     Columns="7"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Selected day"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>

                            <TextBlock x:Name="CalendarSelectedDateText"
                                       Text="Today"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="#202329"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,18,0,14">

                            <StackPanel>
                                <TextBlock Text="REMINDERS"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>

                                <TextBlock x:Name="CalendarSelectedCountText"
                                           Text="0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#202329"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CalendarRemindersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA"
                                                    BorderBrush="#E5E7EA"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="11"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#30353B"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding IsCompleted, StringFormat={}{0:Completed}}"
                                                               FontSize="11"
                                                               Foreground="#7B818A"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="CalendarEmptyText"
                                       Text="No reminders for this day."
                                       FontSize="13"
                                       Foreground="#8A9098"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Rewards -->
        <Grid x:Name="RewardsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Rewards"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Everything you've earned from the Store."
                               FontSize="14"
                               Foreground="#7B818A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16">

                            <TextBlock Text="C"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8A6815"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="COIN BALANCE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>

                            <TextBlock x:Name="RewardsCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#17191C"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RewardItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220"
                                        Background="#FAFBFC"
                                        BorderBrush="#E4E7EA"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="15"
                                        Margin="0,0,12,12">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="82"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                Margin="0,0,0,13">

                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="42"
                                                         Fill="{DynamicResource AccentBrush}"/>

                                                <TextBlock Text="R"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202329"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#7B818A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,13"/>

                                        <Button Grid.Row="3"
                                                Content="{Binding ActionText}"
                                                Tag="{Binding}"
                                                Height="36"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="StoreItemButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Store -->
        <Grid x:Name="StoreContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Store"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#17191C"/>

                    <TextBlock Text="Spend your coins on themes and personalize the app."
                               FontSize="14"
                               Foreground="#7B818A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16"
                                VerticalAlignment="Center">

                            <Grid>
                                <Ellipse Width="22"
                                         Height="22"
                                         Stroke="#C79620"
                                         StrokeThickness="2"
                                         Fill="#FFD966"/>

                                <TextBlock Text="C"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#8A6815"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                            <TextBlock Text="YOUR COINS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#9297A0"/>

                            <TextBlock x:Name="StoreCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#17191C"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="StoreItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Width="220"
                                        Background="#FAFBFC"
                                        BorderBrush="#E4E7EA"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="15"
                                        Margin="0,0,12,12">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="82"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                Margin="0,0,0,13">

                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="42"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>

                                                <TextBlock Text="T"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#202329"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#7B818A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,13"/>

                                        <Button Grid.Row="3"
                                                Content="{Binding ActionText}"
                                                Tag="{Binding}"
                                                Height="36"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="StoreItemButton_Click"/>
                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Border>

        </Grid>

        <!-- Achievements -->
        <Grid x:Name="AchievementsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">
                <TextBlock Text="Achievements"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#17191C"/>

                <TextBlock Text="Complete reminders, earn coins, and keep building your streak."
                           FontSize="14"
                           Foreground="#7B818A"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="180"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    Background="White"
                    BorderBrush="#E2E5E9"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="88"
                            Height="88"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="24"
                            VerticalAlignment="Center">

                        <Grid>
                            <Ellipse Width="56"
                                     Height="56"
                                     Stroke="#C79620"
                                     StrokeThickness="3"
                                     Fill="#FFD966"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="C"
                                       Foreground="#8A6815"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="22,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Complete a reminder"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#202329"/>

                        <TextBlock Text="Finish a reminder and earn coins every time."
                                   FontSize="13"
                                   Foreground="#747A83"
                                   Margin="0,5,0,11"/>

                        <Border Width="110"
                                Height="34"
                                Background="#FFF8E5"
                                BorderBrush="#F0D889"
                                BorderThickness="1"
                                CornerRadius="9">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="+10"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#9A731A"/>

                                <TextBlock Text=" coins"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#9A731A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Completion Confirmation -->
        <Grid x:Name="CompletionConfirmationOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="#66000000">

            <Border Width="470"
                    Background="White"
                    CornerRadius="20"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="8"
                                      Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>

                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="16"
                            HorizontalAlignment="Left">

                        <TextBlock Text="?"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="One quick question"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#17191C"
                               Margin="0,20,0,0"/>

                    <TextBlock Text="Did you actually finish this, or are you trying to fool me?"
                               FontSize="15"
                               Foreground="#666D76"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Border Background="#F7F8FA"
                            BorderBrush="#E5E7EA"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,18,0,0">

                        <TextBlock x:Name="ConfirmationReminderText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#353A41"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Confirming this reminder will add 10 coins."
                               FontSize="12"
                               Foreground="#8A9098"
                               Margin="0,10,0,0"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Not yet"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#F1F3F5"
                                Foreground="#4C535C"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="CancelCompletionConfirmation_Click"/>

                        <Button Grid.Column="1"
                                Content="Yes, I finished"
                                Height="40"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="ConfirmCompletion_Click"/>
                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>