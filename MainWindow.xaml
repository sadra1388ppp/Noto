                             Fill="#FFFFA54F"/>
                    <Ellipse Width="2.6"
                             Height="2.6"
                             Canvas.Left="49"
                             Canvas.Top="21"
                             Fill="#FFFFA54F"/>
                </Canvas>

                <!-- Tiny low-cost fireflies -->
                <Ellipse x:Name="HalloweenSparkleOpacity"
                         Width="6"
                         Height="6"
                         Canvas.Right="326"
                         Canvas.Top="22"
                         Fill="#FFFFA23D"/>

                <Ellipse Width="4"
                         Height="4"
                         Canvas.Right="348"
                         Canvas.Top="54"
                         Fill="#FFB77CFF"
                         Opacity="0.75"/>
                <Ellipse Width="3"
                         Height="3"
                         Canvas.Right="315"
                         Canvas.Top="62"
                         Fill="#FFFFC46F"
                         Opacity="0.75"/>
                <Ellipse Width="4"
                         Height="4"
                         Canvas.Right="300"
                         Canvas.Top="46"
                         Fill="#FFC27BFF"
                         Opacity="0.70"/>
            </Canvas>
        </Grid>

        <Grid x:Name="HalloweenBackdrop"
              Grid.ColumnSpan="2"
              Panel.ZIndex="0"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FF0B0710" Offset="0"/>
                    <GradientStop Color="#FF160C20" Offset="0.42"/>
                    <GradientStop Color="#FF241028" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        
        <Grid x:Name="ForestBackdrop"
              Grid.ColumnSpan="2"
              Panel.ZIndex="0"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FF06120A" Offset="0"/>
                    <GradientStop Color="#FF0A1F12" Offset="0.48"/>
                    <GradientStop Color="#FF12351D" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>


        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reminders"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="6,6,0,24"/>

                <ListBox Grid.Row="1"
                         x:Name="ListsList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ListsList_SelectionChanged">

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="All Reminders"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SidebarAllCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Calendar"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Rewards"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Achievements"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Store"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">

                    <TextBlock Text="MY LISTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#9499A1"
                               Margin="7,0,0,10"/>

                    <ListBox x:Name="CustomListsList"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="CustomListsList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="0"
                                        CornerRadius="8">

                                    <Border.ContextMenu>

                                        <ContextMenu
                                            Style="{StaticResource ListContextMenuStyle}"
                                            DataContext="{Binding PlacementTarget.DataContext,
                                                RelativeSource={RelativeSource Self}}">

                                            <MenuItem Header="Delete List"
                                                      Style="{StaticResource DeleteMenuItemStyle}"
                                                      Click="DeleteList_Click"/>

                                        </ContextMenu>

                                    </Border.ContextMenu>

                                    <Grid Margin="2,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#3478F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock x:Name="NoListsText"
                               Text="No custom lists"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="12,6,0,0"/>

                </StackPanel>

                <Border Grid.Row="3"
                        x:Name="NewListPanel"
                        Visibility="Collapsed"
                        Background="#F6F7F9"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="9"
                        Margin="0,10,0,8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewListInput"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CreateList_Click"/>

                        <Button Grid.Column="2"
                                Content="×"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CancelNewList_Click"/>

                    </Grid>

                </Border>

                <Button Grid.Row="4"
                        Content="+  New List"
                        Style="{StaticResource ActionButtonStyle}"
                        HorizontalContentAlignment="Left"
                        FontWeight="SemiBold"
                        Click="NewListButton_Click"/>

            </Grid>

        </Border>

        <!-- Main -->
        <Grid x:Name="ReminderContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,26">

                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="All Reminders"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Everything you want to remember, in one place."
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="255"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                    <TextBox x:Name="SearchInput"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Search reminders"
                             TextChanged="SearchInput_TextChanged"/>
                </Border>

            </Grid>

            <!-- Add Reminder -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReminderInput"
                             Grid.Column="0"
                             Height="46"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Reminder title"/>

                    <Grid Grid.Column="1"
                          Margin="10,0,10,0">

                        <Border Height="46"
                                Background="{DynamicResource ContentSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="DueDatePlaceholderText"
                                               Text="Choose date"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <TextBox x:Name="DueDateInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             Foreground="{DynamicResource BodyTextBrush}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Type a date, for example: tomorrow, Oct 12, or 12/10/2026"
                                             TextChanged="DueDateInput_TextChanged"
                                             LostFocus="DueDateInput_LostFocus"
                                             KeyDown="DueDateInput_KeyDown"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DueDateIconButtonStyle}"
                                        Click="DueDateButton_Click"
                                        ToolTip="Choose a date from the calendar">
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="DueDatePopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DueDateInput}"
                               HorizontalOffset="-12"
                               VerticalOffset="10"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">

                            <Border Width="320"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">


                                <StackPanel>
                                    <Grid Margin="2,0,2,12">
                                        <StackPanel>
                                            <TextBlock Text="Choose a due date"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                                            <TextBlock Text="Pick a date or type one directly above."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Content="Today"
                                                Width="58"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateToday_Click"/>
                                    </Grid>

                                    <Calendar x:Name="DueDateCalendar"
                                              BorderThickness="0"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource BodyTextBrush}"
                                              SelectedDatesChanged="DueDateCalendar_SelectedDatesChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Button Content="Tomorrow"
                                                Width="78"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateTomorrow_Click"/>

                                        <Button Content="Clear"
                                                Width="52"
                                                Height="32"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="ClearDueDate_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="2"
                            Content="Add Reminder"
                            Width="125"
                            Height="46"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddReminder_Click"/>

                </Grid>

            </Border>

            <!-- Reminder list -->
            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="2,0,2,10">

                    <TextBlock Text="Reminders"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock x:Name="ReminderCountText"
                               HorizontalAlignment="Right"
                               Text="0"
                               FontSize="13"
                               Foreground="{DynamicResource SubtleTextBrush}"/>

                </Grid>

                <Grid Grid.Row="1">

                    <ListBox x:Name="ReminderList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ReminderItemStyle}">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ReminderCheckBoxStyle}"
                                                      PreviewMouseLeftButtonDown="ReminderCheckBox_PreviewMouseLeftButtonDown"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:d}'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       Margin="32,5,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Tag="{Binding}"
                                                Style="{StaticResource ReminderDeleteButtonStyle}"
                                                Click="DeleteReminder_Click"
                                                ToolTip="Delete reminder">
                                            <TextBlock Text="×"
                                                       FontSize="20"
                                                       FontWeight="Medium"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="No reminders"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Add your first reminder above."
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <!-- Calendar -->
        <Grid x:Name="CalendarContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Calendar"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="See your reminders by date and keep the month in view."
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Today"
                            Width="72"
                            Height="38"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="CalendarToday_Click"/>

                    <Button Content="‹"
                            Width="38"
                            Height="38"
                            Margin="0,0,5,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
