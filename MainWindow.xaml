<Window x:Class="SimpleReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Reminders"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2865DB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="ContentSoftBrush" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E5E9"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CDD2D8"/>
        <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#F1F3F6"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17191C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#202329"/>
        <SolidColorBrush x:Key="BodyTextBrush" Color="#30353B"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555B66"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7B818A"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A9098"/>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverSurfaceBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#70757D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="Foreground" Value="#202329"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF1F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReminderItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#24272C"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="21"
                                  Height="21"
                                  Margin="0,0,11,0"
                                  VerticalAlignment="Center">

                                <Border x:Name="CheckBoxBorder"
                                        Width="21"
                                        Height="21"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"/>

                                <Path x:Name="CheckMark"
                                      Data="M 4.5,10.5 L 8.5,14.2 L 16.5,6.5"
                                      Stroke="White"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>

                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter Property="Foreground"
                                        Value="#8E949C"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                                <Setter Property="Foreground"
                                        Value="#A0A5AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReminderDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                                Width="32"
                                Height="32"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#FFF1F1"/>
                                <Setter Property="Foreground"
                                        Value="#D64545"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DeleteBorder"
                                        Property="Background"
                                        Value="#FFE3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DueDateIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#737982"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="38"
                              Height="38"
                              RenderTransformOrigin="0.5,0.5">

                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale"
                                                ScaleX="1"
                                                ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Ellipse x:Name="HoverSurface"
                                     Width="34"
                                     Height="34"
                                     Fill="{DynamicResource AccentSoftBrush}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <Grid Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <Path x:Name="CalendarIcon"
                                      Data="M 5,3.5 L 5,6.5 M 15,3.5 L 15,6.5 M 4.5,5.5 H 15.5 Q 18,5.5 18,8 V 15.5 Q 18,18 15.5,18 H 4.5 Q 2,18 2,15.5 V 8 Q 2,5.5 4.5,5.5 Z M 2.8,9 H 17.2"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"/>

                                <Path x:Name="CalendarIconAccent"
                                      Data="M 5,3.5 L 5,6.5 M 15,3.5 L 15,6.5 M 4.5,5.5 H 15.5 Q 18,5.5 18,8 V 15.5 Q 18,18 15.5,18 H 4.5 Q 2,18 2,15.5 V 8 Q 2,5.5 4.5,5.5 Z M 2.8,9 H 17.2"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Opacity="0"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0">

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{TemplateBinding Foreground}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0"
                                            Opacity="0">

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Margin="0,0,2,0"/>

                                    <Ellipse Width="1.8"
                                             Height="1.8"
                                             Fill="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="CalendarIconAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97"
                                                             Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StorePurchaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StoreButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StoreButtonBorder"
                                        Property="Background"
                                        Value="#E7E9ED"/>
                                <Setter Property="Foreground"
                                        Value="#8A9098"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEquipped}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
</Style.Triggers>
        </Style>

        <Style x:Key="StoreCategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="Foreground" Value="#555B66"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="CategoryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CategoryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid x:Name="RootLayout">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Halloween atmospheric overlay -->
        <Canvas x:Name="HalloweenEffectsOverlay"
                Grid.ColumnSpan="2"
                IsHitTestVisible="False"
                Panel.ZIndex="200"
                Visibility="Collapsed"
                ClipToBounds="False">

            <!-- Natural moon, tucked into the corner so it never blocks controls -->
            <Canvas Canvas.Right="8"
                    Canvas.Top="-6"
                    Width="132"
                    Height="132"
                    IsHitTestVisible="False">

                <Ellipse Width="132"
                         Height="132"
                         Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.48,0.44">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFDDBDFF" Offset="0.42"/>
                            <GradientStop Color="#006A3C80" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="104"
                         Height="104"
                         Canvas.Left="14"
                         Canvas.Top="14"
                         Fill="#FFE9DFFF"
                         Opacity="0.95">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Color="#FFA96BFF"
                                          Opacity="0.36"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- soft lunar craters -->
                <Ellipse Width="19"
                         Height="12"
                         Canvas.Left="30"
                         Canvas.Top="34"
                         Fill="#FFCDBEDF"
                         Opacity="0.27"/>
                <Ellipse Width="12"
                         Height="8"
                         Canvas.Left="68"
                         Canvas.Top="25"
                         Fill="#FFCDBEDF"
                         Opacity="0.23"/>
                <Ellipse Width="24"
                         Height="15"
                         Canvas.Left="69"
                         Canvas.Top="63"
                         Fill="#FFCDBEDF"
                         Opacity="0.22"/>
                <Ellipse Width="10"
                         Height="7"
                         Canvas.Left="40"
                         Canvas.Top="76"
                         Fill="#FFCDBEDF"
                         Opacity="0.20"/>
                <Ellipse Width="7"
                         Height="7"
                         Canvas.Left="82"
                         Canvas.Top="42"
                         Fill="#FFCDBEDF"
                         Opacity="0.18"/>
            </Canvas>

            <!-- Left hanging pumpkin -->
            <Canvas Canvas.Left="258"
                    Canvas.Top="-10"
                    Width="112"
                    Height="136"
                    RenderTransformOrigin="0.5,0"
                    IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="HalloweenPumpkinLeftRotate" Angle="-2.5"/>
                </Canvas.RenderTransform>

                <Line X1="56" Y1="0" X2="56" Y2="34" Stroke="#FF4A3D54" StrokeThickness="2"/>
                <Line X1="56" Y1="2" X2="56" Y2="34" Stroke="#FFBCA9C8" StrokeThickness="1"/>

                <Path Data="M 54,31 C 43,24 30,28 24,40 C 16,55 19,79 31,93 C 43,107 68,107 81,92 C 94,77 96,53 86,39 C 78,28 66,24 57,31 Z"
                      Fill="#FFED7423"
                      Stroke="#FFB95118"
                      StrokeThickness="1.2"/>

                <Path Data="M 55,31 C 45,43 43,77 55,97 C 65,78 67,45 55,31 Z"
                      Fill="#FFFF9B45"
                      Opacity="0.22"/>

                <Path Data="M 35,36 C 28,51 29,77 38,91"
                      Stroke="#FFB94C17"
                      StrokeThickness="3"
                      Opacity="0.72"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Path Data="M 76,36 C 84,52 83,77 74,91"
                      Stroke="#FFB94C17"
                      StrokeThickness="3"
                      Opacity="0.72"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <Path Data="M 49,30 C 47,23 51,18 59,17 C 63,20 64,26 61,32 Z"
                      Fill="#FF4D672B"/>
                <Path Data="M 59,20 Q 64,13 69,17 Q 66,23 62,26"
                      Stroke="#FF6B8242"
                      StrokeThickness="2"
                      Fill="Transparent"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <Path Data="M 30,55 L 43,49 L 49,58 L 38,63 Z"
                      Fill="#FF211723"/>
                <Path Data="M 64,58 L 70,49 L 83,55 L 75,63 Z"
                      Fill="#FF211723"/>

                <Path Data="M 35,72 Q 54,85 76,71 Q 68,94 53,94 Q 41,92 35,72 Z"
                      Fill="#FF211723"/>
                <Path Data="M 45,81 L 49,88 L 54,81 L 59,89 L 64,81"
                      Stroke="#FFFFB95E"
                      StrokeThickness="1.2"
                      Fill="Transparent"
                      Opacity="0.8"/>

                <Ellipse Width="12" Height="5" Canvas.Left="33" Canvas.Top="47" Fill="#FFFFC47A" Opacity="0.20"/>
            </Canvas>

            <!-- Right hanging pumpkin -->
            <Canvas Canvas.Right="130"
                    Canvas.Top="-4"
                    Width="124"
                    Height="150"
                    RenderTransformOrigin="0.5,0"
                    IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="HalloweenPumpkinRightRotate" Angle="3"/>
                </Canvas.RenderTransform>

                <Line X1="62" Y1="0" X2="62" Y2="40" Stroke="#FF4A3D54" StrokeThickness="2"/>
                <Line X1="62" Y1="2" X2="62" Y2="40" Stroke="#FFC6B4D2" StrokeThickness="1"/>

                <Path Data="M 60,36 C 48,27 33,31 26,44 C 17,61 21,88 34,105 C 47,121 78,120 91,104 C 104,87 106,62 96,46 C 88,33 71,27 60,36 Z"
                      Fill="#FFF17824"
                      Stroke="#FFC05A18"
                      StrokeThickness="1.2"/>

                <Path Data="M 60,36 C 52,51 50,88 61,111 C 71,90 73,50 60,36 Z"
                      Fill="#FFFFA651"
                      Opacity="0.20"/>

                <Path Data="M 37,41 C 29,59 31,88 42,103"
                      Stroke="#FFB94C17"
                      StrokeThickness="3.2"
                      Opacity="0.72"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Path Data="M 84,41 C 93,59 91,88 81,104"
                      Stroke="#FFB94C17"
                      StrokeThickness="3.2"
                      Opacity="0.72"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <Path Data="M 56,35 C 54,27 59,21 68,21 C 72,24 72,31 69,36 Z"
                      Fill="#FF4E682E"/>
                <Path Data="M 66,24 Q 72,17 78,22 Q 75,28 69,31"
                      Stroke="#FF70864A"
                      StrokeThickness="2"
                      Fill="Transparent"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <Path Data="M 34,61 L 48,54 L 53,64 L 42,68 Z"
                      Fill="#FF251828"/>
                <Path Data="M 68,64 L 74,54 L 89,61 L 79,69 Z"
                      Fill="#FF251828"/>

                <Path Data="M 39,80 Q 59,95 82,79 Q 74,104 59,105 Q 45,102 39,80 Z"
                      Fill="#FF251828"/>
                <Path Data="M 49,90 L 53,98 L 59,89 L 65,99 L 71,90"
                      Stroke="#FFFFC26F"
                      StrokeThickness="1.2"
                      Fill="Transparent"
                      Opacity="0.78"/>

                <Ellipse Width="13" Height="5" Canvas.Left="36" Canvas.Top="52" Fill="#FFFFC47A" Opacity="0.18"/>
            </Canvas>

            <!-- Organic cobweb corners -->
            <Canvas Canvas.Left="4" Canvas.Top="3" Width="170" Height="150" Opacity="0.46">
                <Path Data="M 0,0 C 55,10 105,12 166,0 M 0,0 C 12,46 14,95 0,148 M 0,0 C 46,28 92,70 129,112"
                      Stroke="#FFBFA9CA"
                      StrokeThickness="1"
                      Fill="Transparent"/>
                <Path Data="M 3,27 Q 34,12 68,8 Q 83,8 101,4 M 9,51 Q 44,35 78,25 Q 96,20 116,10 M 14,80 Q 50,62 91,43 Q 111,32 132,17"
                      Stroke="#FFBFA9CA"
                      StrokeThickness="1"
                      Fill="Transparent"/>
            </Canvas>

            <!-- Drifting fog layers -->
            <Ellipse x:Name="HalloweenFogAOpacity"
                     Width="650"
                     Height="185"
                     Canvas.Left="-150"
                     Canvas.Bottom="24"
                     Fill="#FFA96BFF"
                     Opacity="0.15">
                <Ellipse.Effect>
                    <BlurEffect Radius="34"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="HalloweenFogBOpacity"
                     Width="780"
                     Height="205"
                     Canvas.Right="-210"
                     Canvas.Bottom="-8"
                     Fill="#FF6A8DB8"
                     Opacity="0.10">
                <Ellipse.Effect>
                    <BlurEffect Radius="40"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Flying bat: larger, outlined and visible against the dark theme -->
            <Canvas Canvas.Left="0"
                    Canvas.Top="126"
                    Width="112"
                    Height="58"
                    IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="HalloweenBatTranslate" X="-130"/>
                </Canvas.RenderTransform>

                <Path Data="M 56,27
                            C 48,18 40,15 31,18
                            C 22,21 14,15 3,10
                            C 7,20 14,28 23,31
                            C 16,34 11,41 6,49
                            C 18,47 31,43 41,35
                            C 46,42 51,46 56,46
                            C 61,46 66,42 71,35
                            C 81,43 94,47 106,49
                            C 101,41 96,34 89,31
                            C 98,28 105,20 109,10
                            C 98,15 90,21 81,18
                            C 72,15 64,18 56,27 Z"
                      Fill="#FF0A0710"
                      Stroke="#FF8F6AA8"
                      StrokeThickness="1.15"
                      StrokeLineJoin="Round"
                      Opacity="0.98">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#FF000000"
                                          Opacity="0.45"/>
                    </Path.Effect>
                </Path>

                <Ellipse Width="16"
                         Height="25"
                         Canvas.Left="48"
                         Canvas.Top="20"
                         Fill="#FF110B18"/>

                <Path Data="M 48,22 L 51,15 L 55,22 M 57,22 L 61,15 L 64,22"
                      Stroke="#FF0A0710"
                      StrokeThickness="2.2"
                      StrokeLineJoin="Round"
                      Fill="Transparent"/>

                <Ellipse Width="3.2"
                         Height="3.2"
                         Canvas.Left="51"
                         Canvas.Top="27"
                         Fill="#FFFFA24A"
                         Opacity="0.95"/>
                <Ellipse Width="3.2"
                         Height="3.2"
                         Canvas.Left="58"
                         Canvas.Top="27"
                         Fill="#FFFFA24A"
                         Opacity="0.95"/>
            </Canvas>

            <!-- Floating embers and fireflies -->
            <Ellipse x:Name="HalloweenSparkleOpacity"
                     Width="7"
                     Height="7"
                     Canvas.Left="462"
                     Canvas.Top="102"
                     Fill="#FFFFA23D"/>

            <Ellipse Width="5" Height="5" Canvas.Left="520" Canvas.Top="168" Fill="#FFC27BFF" Opacity="0.72"/>
            <Ellipse Width="4" Height="4" Canvas.Left="632" Canvas.Top="126" Fill="#FFFFB85B" Opacity="0.78"/>
            <Ellipse Width="6" Height="6" Canvas.Left="742" Canvas.Top="214" Fill="#FFB77CFF" Opacity="0.68"/>
            <Ellipse Width="4" Height="4" Canvas.Left="804" Canvas.Top="156" Fill="#FFFFA23D" Opacity="0.74"/>
            <Ellipse Width="5" Height="5" Canvas.Left="880" Canvas.Top="238" Fill="#FFC27BFF" Opacity="0.72"/>
            <Ellipse Width="3" Height="3" Canvas.Left="946" Canvas.Top="188" Fill="#FFFFC46F" Opacity="0.8"/>

            <!-- Subtle top vignette -->
            <Border Width="1000"
                    Height="170"
                    Canvas.Left="80"
                    Canvas.Top="-90"
                    CornerRadius="90"
                    Opacity="0.16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF5A2E78" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Canvas>

        <Grid x:Name="HalloweenBackdrop"
              Grid.ColumnSpan="2"
              Panel.ZIndex="0"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FF0B0710" Offset="0"/>
                    <GradientStop Color="#FF160C20" Offset="0.42"/>
                    <GradientStop Color="#FF241028" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reminders"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="6,6,0,24"/>

                <ListBox Grid.Row="1"
                         x:Name="ListsList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ListsList_SelectionChanged">

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="All Reminders"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="SidebarAllCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Calendar"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Rewards"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Achievements"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource SidebarItemStyle}">
                        <Grid>
                            <TextBlock Text="Store"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">

                    <TextBlock Text="MY LISTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#9499A1"
                               Margin="7,0,0,10"/>

                    <ListBox x:Name="CustomListsList"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="CustomListsList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="0"
                                        CornerRadius="8">

                                    <Border.ContextMenu>

                                        <ContextMenu
                                            Style="{StaticResource ListContextMenuStyle}"
                                            DataContext="{Binding PlacementTarget.DataContext,
                                                RelativeSource={RelativeSource Self}}">

                                            <MenuItem Header="Delete List"
                                                      Style="{StaticResource DeleteMenuItemStyle}"
                                                      Click="DeleteList_Click"/>

                                        </ContextMenu>

                                    </Border.ContextMenu>

                                    <Grid Margin="2,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#3478F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock x:Name="NoListsText"
                               Text="No custom lists"
                               FontSize="13"
                               Foreground="#9A9FA7"
                               Margin="12,6,0,0"/>

                </StackPanel>

                <Border Grid.Row="3"
                        x:Name="NewListPanel"
                        Visibility="Collapsed"
                        Background="#F6F7F9"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="9"
                        Margin="0,10,0,8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewListInput"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Save"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CreateList_Click"/>

                        <Button Grid.Column="2"
                                Content="×"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CancelNewList_Click"/>

                    </Grid>

                </Border>

                <Button Grid.Row="4"
                        Content="+  New List"
                        Style="{StaticResource ActionButtonStyle}"
                        HorizontalContentAlignment="Left"
                        FontWeight="SemiBold"
                        Click="NewListButton_Click"/>

            </Grid>

        </Border>

        <!-- Main -->
        <Grid x:Name="ReminderContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,26">

                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="All Reminders"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Everything you want to remember, in one place."
                               FontSize="14"
                               Foreground="#7D828A"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="255"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="9">

                    <TextBox x:Name="SearchInput"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Search reminders"
                             TextChanged="SearchInput_TextChanged"/>
                </Border>

            </Grid>

            <!-- Add Reminder -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReminderInput"
                             Grid.Column="0"
                             Height="46"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Reminder title"/>

                    <Grid Grid.Column="1"
                          Margin="10,0,10,0">

                        <Border Height="46"
                                Background="#F8F9FB"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="DueDatePlaceholderText"
                                               Text="Choose date"
                                               FontSize="12"
                                               Foreground="#9A9FA7"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <TextBox x:Name="DueDateInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             Foreground="{DynamicResource BodyTextBrush}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Type a date, for example: tomorrow, Oct 12, or 12/10/2026"
                                             TextChanged="DueDateInput_TextChanged"
                                             LostFocus="DueDateInput_LostFocus"
                                             KeyDown="DueDateInput_KeyDown"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DueDateIconButtonStyle}"
                                        Click="DueDateButton_Click"
                                        ToolTip="Choose a date from the calendar">
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="DueDatePopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DueDateInput}"
                               HorizontalOffset="-12"
                               VerticalOffset="10"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">

                            <Border Width="320"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="#E0E4E8"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      ShadowDepth="5"
                                                      Opacity="0.18"/>
                                </Border.Effect>

                                <StackPanel>
                                    <Grid Margin="2,0,2,12">
                                        <StackPanel>
                                            <TextBlock Text="Choose a due date"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                                            <TextBlock Text="Pick a date or type one directly above."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Content="Today"
                                                Width="58"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateToday_Click"/>
                                    </Grid>

                                    <Calendar x:Name="DueDateCalendar"
                                              BorderThickness="0"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource BodyTextBrush}"
                                              SelectedDatesChanged="DueDateCalendar_SelectedDatesChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Button Content="Tomorrow"
                                                Width="78"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Foreground="#6E747C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="DueDateTomorrow_Click"/>

                                        <Button Content="Clear"
                                                Width="52"
                                                Height="32"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                Foreground="#6E747C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Click="ClearDueDate_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="2"
                            Content="Add Reminder"
                            Width="125"
                            Height="46"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddReminder_Click"/>

                </Grid>

            </Border>

            <!-- Reminder list -->
            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="2,0,2,10">

                    <TextBlock Text="Reminders"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#25282D"/>

                    <TextBlock x:Name="ReminderCountText"
                               HorizontalAlignment="Right"
                               Text="0"
                               FontSize="13"
                               Foreground="#858A92"/>

                </Grid>

                <Grid Grid.Row="1">

                    <ListBox x:Name="ReminderList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ReminderItemStyle}">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ReminderCheckBoxStyle}"
                                                      PreviewMouseLeftButtonDown="ReminderCheckBox_PreviewMouseLeftButtonDown"/>

                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:d}'}"
                                                       FontSize="12"
                                                       Foreground="#8C929A"
                                                       Margin="32,5,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Tag="{Binding}"
                                                Style="{StaticResource ReminderDeleteButtonStyle}"
                                                Click="DeleteReminder_Click"
                                                ToolTip="Delete reminder">
                                            <TextBlock Text="×"
                                                       FontSize="20"
                                                       FontWeight="Medium"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="No reminders"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#34373C"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Add your first reminder above."
                                   FontSize="14"
                                   Foreground="#8A8F97"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <!-- Calendar -->
        <Grid x:Name="CalendarContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Calendar"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="See your reminders by date and keep the month in view."
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Today"
                            Width="72"
                            Height="38"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="#4E555E"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="CalendarToday_Click"/>

                    <Button Content="‹"
                            Width="38"
                            Height="38"
                            Margin="0,0,5,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="#4E555E"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="22"
                            Click="PreviousMonth_Click"/>

                    <Button Content="›"
                            Width="38"
                            Height="38"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="#4E555E"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            FontSize="22"
                            Click="NextMonth_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,18,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CalendarMonthText"
                                   Text="October 2026"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="2,0,0,16"/>

                        <UniformGrid Grid.Row="1"
                                     Columns="7"
                                     Margin="0,0,0,7">

                            <TextBlock Text="SUN" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="MON" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="TUE" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="WED" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="THU" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="FRI" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>
                            <TextBlock Text="SAT" FontSize="10" FontWeight="SemiBold" Foreground="#9A9FA7" TextAlignment="Center"/>

                        </UniformGrid>

                        <UniformGrid x:Name="CalendarDaysGrid"
                                     Grid.Row="2"
                                     Rows="6"
                                     Columns="7"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Selected day"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>

                            <TextBlock x:Name="CalendarSelectedDateText"
                                       Text="Today"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,18,0,14">

                            <StackPanel>
                                <TextBlock Text="REMINDERS"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>

                                <TextBlock x:Name="CalendarSelectedCountText"
                                           Text="0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CalendarRemindersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ContentSoftBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="11"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BodyTextBrush}"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding IsCompleted, StringFormat={}{0:Completed}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="CalendarEmptyText"
                                       Text="No reminders for this day."
                                       FontSize="13"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Rewards -->
        <Grid x:Name="RewardsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Rewards"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Everything you've earned from the Store."
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16">

                            <TextBlock Text="C"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8A6815"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="COIN BALANCE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>

                            <TextBlock x:Name="RewardsCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RewardItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="#E4E7EA"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="15"
                                        Margin="0,0,12,12">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="82"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                Margin="0,0,0,13">

                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="42"
                                                         Fill="{DynamicResource AccentBrush}"/>

                                                <TextBlock Text="R"
                                                           Foreground="White"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,13"/>

                                        <Button Grid.Row="3"
                                                Content="{Binding ActionText}"
                                                Tag="{Binding}"
                                                Height="36"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="StoreItemButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Store -->
        <Grid x:Name="StoreContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <StackPanel>
                    <TextBlock Text="Store"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Choose a category and customize your Noto experience."
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="180"
                        Height="52"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32"
                                Height="32"
                                Background="#FFF3C4"
                                CornerRadius="16"
                                VerticalAlignment="Center">

                            <Grid>
                                <Ellipse Width="22"
                                         Height="22"
                                         Stroke="#C79620"
                                         StrokeThickness="2"
                                         Fill="#FFD966"/>

                                <TextBlock Text="C"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#8A6815"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                            <TextBlock Text="YOUR COINS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtleTextBrush}"/>

                            <TextBlock x:Name="StoreCoinsText"
                                       Text="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StoreAllButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Content="ALL"
                        Tag="All"
                        Style="{StaticResource StoreCategoryButtonStyle}"
                        Click="StoreCategoryButton_Click"/>

                <Button x:Name="StoreThemesButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="THEMES"
                        Tag="Themes"
                        Style="{StaticResource StoreCategoryButtonStyle}"
                        Click="StoreCategoryButton_Click"/>

                <Button x:Name="StoreSkinsButton"
                        Grid.Row="0"
                        Grid.Column="4"
                        Content="SKINS"
                        Tag="Skins"
                        Style="{StaticResource StoreCategoryButtonStyle}"
                        Click="StoreCategoryButton_Click"/>
</Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="6,2,6,16">
                        <StackPanel>
                            <TextBlock x:Name="StoreCategoryTitle"
                                       Text="Featured Collection"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock x:Name="StoreCategoryDescription"
                                       Text="Preview every item before you spend your coins."
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="9"
                                Padding="10,6"
                                VerticalAlignment="Center">

                            <TextBlock Text="LIVE CATALOG"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="StoreItemsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="StoreItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Width="300"
                                                Height="286"
                                                Background="{DynamicResource SurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14"
                                                Margin="0,0,14,14">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="118"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Background="{Binding PreviewBackground}"
                                                        CornerRadius="12"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle Fill="#160D21"
                                                                   Opacity="0.22"/>

                                                        <!-- Moon -->
                                                        <Ellipse Width="74"
                                                                 Height="74"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,10,14,0"
                                                                 Fill="#FFE8D8FF"
                                                                 Opacity="0.96"/>

                                                        <Ellipse Width="34"
                                                                 Height="34"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,28,50,0"
                                                                 Fill="{Binding PreviewBackground}"
                                                                 Opacity="0.98"/>

                                                        <!-- Moon glow -->
                                                        <Ellipse Width="112"
                                                                 Height="112"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,-10,-5,0"
                                                                 Fill="{Binding PreviewSoft}"
                                                                 Opacity="0.25"/>

                                                        <!-- Stars -->
                                                        <TextBlock Text="✦"
                                                                   FontSize="13"
                                                                   Foreground="#FFFFC56E"
                                                                   Margin="22,18,0,0"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Text="·"
                                                                   FontSize="17"
                                                                   Foreground="#FFC58EFF"
                                                                   Margin="54,40,0,0"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>
                                                        <TextBlock Text="✦"
                                                                   FontSize="9"
                                                                   Foreground="#FFB77CFF"
                                                                   Margin="92,22,0,0"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Top"/>

                                                        <!-- Haunted skyline -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="0,0,0,20">
                                                            <Rectangle Width="34" Height="36" Fill="#FF1D1225"/>
                                                            <Polygon Points="10,0 24,0 30,8 4,8"
                                                                     Fill="#FF1D1225"
                                                                     Margin="-34,0,0,28"/>
                                                            <Rectangle Width="56" Height="48" Fill="#FF140C1B"/>
                                                            <Rectangle Width="30" Height="30" Fill="#FF1D1225"/>
                                                        </StackPanel>

                                                        <!-- Foreground hill -->
                                                        <Path Data="M 0,96 Q 70,74 140,96 T 300,94 L 300,118 L 0,118 Z"
                                                              Fill="#FF0F0914"
                                                              Opacity="0.96"/>

                                                        <!-- Pumpkin -->
                                                        <Canvas Width="68"
                                                                Height="68"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="24,0,0,14">
                                                            <Ellipse Width="26" Height="40" Canvas.Left="22" Canvas.Top="20" Fill="#FFF17824"/>
                                                            <Ellipse Width="32" Height="46" Canvas.Left="7" Canvas.Top="18" Fill="#FFFF872B"/>
                                                            <Ellipse Width="32" Height="46" Canvas.Left="36" Canvas.Top="18" Fill="#FFFF7520"/>
                                                            <Path Data="M 33,22 C 29,16 34,12 40,13 C 44,16 42,21 39,24 Z"
                                                                  Fill="#FF526C31"/>
                                                            <Path Data="M 14,37 L 26,31 L 30,39 L 21,43 Z"
                                                                  Fill="#FF24172A"/>
                                                            <Path Data="M 39,39 L 43,31 L 55,37 L 48,43 Z"
                                                                  Fill="#FF24172A"/>
                                                            <Path Data="M 20,48 Q 34,58 49,48 Q 43,59 34,60 Q 26,58 20,48 Z"
                                                                  Fill="#FF24172A"/>
                                                        </Canvas>

                                                        <!-- Bat -->
                                                        <Path Data="M 224,35 C 218,28 212,27 205,29 C 199,32 193,28 186,25 C 190,33 195,37 201,39 C 195,41 190,45 187,49 C 196,47 205,45 211,41 C 215,46 219,48 223,48 C 227,48 231,46 235,41 C 241,45 250,47 259,49 C 256,45 251,41 245,39 C 251,37 256,33 260,25 C 252,28 247,32 241,29 C 234,27 229,28 224,35 Z"
                                                              Fill="#FF17101F"
                                                              Opacity="0.94"
                                                              Margin="0,20,18,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"/>

                                                        <!-- Mist -->
                                                        <Ellipse Width="210"
                                                                 Height="42"
                                                                 Fill="#FFE2CFFF"
                                                                 Opacity="0.10"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Bottom"
                                                                 Margin="0,0,0,9">
                                                            <Ellipse.Effect>
                                                                <BlurEffect Radius="12"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="1"
                                                      Margin="2,12,2,0">

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>

                                                    <Border HorizontalAlignment="Right"
                                                            Background="{Binding PreviewSoft}"
                                                            CornerRadius="7"
                                                            Padding="7,4">

                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding PreviewAccent}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="2,7,2,10"
                                                           VerticalAlignment="Top"/>

                                                <Grid Grid.Row="3"
                                                      Margin="2,0,2,0">

                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">

                                                        <Border Width="25"
                                                                Height="25"
                                                                Background="#FFF3C4"
                                                                CornerRadius="12.5">

                                                            <TextBlock Text="C"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="#8A6815"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Price}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Text=" coins"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Button Tag="{Binding}"
                                                            Content="{Binding ActionText}"
                                                            Style="{StaticResource StorePurchaseButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            Click="StoreItemButton_Click"/>
                                                </Grid>

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border x:Name="StoreEmptyStatePanel"
                                Visibility="Collapsed"
                                Background="{DynamicResource SurfaceSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="28">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Border Width="72"
                                        Height="72"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="36"
                                        HorizontalAlignment="Center">

                                    <TextBlock x:Name="StoreCategoryIcon"
                                               Text="A"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="StoreCategoryEmptyTitle"
                                           Text="No items available yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BodyTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,4"/>

                                <TextBlock x:Name="StoreCategoryEmptyText"
                                           Text="There are no Store items available yet."
                                           FontSize="13"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- Achievements -->
        <Grid x:Name="AchievementsContentPanel"
              Grid.Column="1"
              Margin="42,34,42,34"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">
                <TextBlock Text="Achievements"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Complete reminders, earn coins, and keep building your streak."
                           FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="180"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="88"
                            Height="88"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="24"
                            VerticalAlignment="Center">

                        <Grid>
                            <Ellipse Width="56"
                                     Height="56"
                                     Stroke="#C79620"
                                     StrokeThickness="3"
                                     Fill="#FFD966"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="C"
                                       Foreground="#8A6815"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="22,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Complete a reminder"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Finish a reminder and earn coins every time."
                                   FontSize="13"
                                   Foreground="#747A83"
                                   Margin="0,5,0,11"/>

                        <Border Width="110"
                                Height="34"
                                Background="#FFF8E5"
                                BorderBrush="#F0D889"
                                BorderThickness="1"
                                CornerRadius="9">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="+10"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#9A731A"/>

                                <TextBlock Text=" coins"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#9A731A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Completion Confirmation -->
        <Grid x:Name="CompletionConfirmationOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="#66000000">

            <Border Width="470"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="20"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="8"
                                      Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>

                    <Border Width="58"
                            Height="58"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="16"
                            HorizontalAlignment="Left">

                        <TextBlock Text="?"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="One quick question"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,20,0,0"/>

                    <TextBlock Text="Did you actually finish this, or are you trying to fool me?"
                               FontSize="15"
                               Foreground="#666D76"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Border Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,18,0,0">

                        <TextBlock x:Name="ConfirmationReminderText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#353A41"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Confirming this reminder will add 10 coins."
                               FontSize="12"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="0,10,0,0"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Not yet"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#F1F3F5"
                                Foreground="#4C535C"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="CancelCompletionConfirmation_Click"/>

                        <Button Grid.Column="1"
                                Content="Yes, I finished"
                                Height="40"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="ConfirmCompletion_Click"/>
                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>